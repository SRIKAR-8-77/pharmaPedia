# Database
DATABASE_URL=postgresql+asyncpg://pharmasignal:pharmasignal_secret@localhost:5432/pharmasignal
DATABASE_URL_SYNC=postgresql://pharmasignal:pharmasignal_secret@localhost:5432/pharmasignal

# Redis
REDIS_URL=redis://localhost:6379/0

# Reddit (PRAW) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=PharmaSignal/1.0 by YourUsername

# Twitter/X — https://twitterapi.io
TWITTER_API_KEY=your_twitterapi_io_key

# Google Gemini — AI Copilot — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# App
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key_in_production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
